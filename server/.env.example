# Copy to server/.env and fill in from Supabase -> Project Settings -> API.
# Without these values the API serves the bundled demo catalog instead.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key

# Optional: only needed for `npm run seed` (uploads images and inserts rows).
# Never expose this key to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Admin panel (/admin/login). Use either a plain password or a scrypt hash.
ADMIN_EMAIL=you@example.com
ADMIN_PASSWORD=change-me
# Generate a hash with: node -e "const c=require('node:crypto');const s=c.randomBytes(16);console.log('scrypt$'+s.toString('hex')+'$'+c.scryptSync(process.argv[1],s,64).toString('hex'))" 'your-password'
# ADMIN_PASSWORD_HASH=scrypt$...

# Optional overrides
SUPABASE_STORAGE_BUCKET=wallpapers
PORT=4000
# Set HOST=0.0.0.0 when running on a host/proxy so the port is reachable from outside.
HOST=127.0.0.1
